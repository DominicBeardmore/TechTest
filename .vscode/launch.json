{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Expo",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/expo/AppEntry.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "EXPO_DEBUG": "true"
      }
    },
    {
      "name": "Debug React Native (iOS)",
      "type": "reactnative",
      "request": "launch",
      "platform": "ios",
      "target": "simulator",
      "sourceMaps": true,
      "outDir": "${workspaceFolder}/.vscode/.react"
    },
    {
      "name": "Debug React Native (Android)",
      "type": "reactnative",
      "request": "launch",
      "platform": "android",
      "target": "emulator",
      "sourceMaps": true,
      "outDir": "${workspaceFolder}/.vscode/.react"
    },
    {
      "name": "Attach to React Native",
      "type": "reactnative",
      "request": "attach",
      "sourceMaps": true,
      "outDir": "${workspaceFolder}/.vscode/.react"
    }
  ]
}
